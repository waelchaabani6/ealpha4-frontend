{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    // "esModuleInterop": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": "./",
    "paths": {
      "@component/*": [
        "src/components/*"
      ],
      "@images/*": [
        "src/assets/images/*"
      ],
      "@fonts/*": [
        "src/assets/fonts/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ],
      "@constants/*": [
        "src/constants/*"
      ],
      "@utility/*": [
        "src/utilities/*"
      ],
      "@layout/*": [
        "src/containers/layout/*"
      ],
      "@containers/*": [
        "src/containers/*"
      ],
      "@routes/*": [
        "src/appRoutes/*"
      ]
    }
  },
  "include": [
    "src",
    "./src/vite-env.d.ts",
    ".eslintrc.json"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ],
}